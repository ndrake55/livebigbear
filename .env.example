# Placeholders only. Never put real values in this file: it is committed to GitHub.
DATABASE_URL=
NWS_CONTACT_EMAIL=
CRON_SECRET=

# Email (Amazon SES). Signup stays hidden until all four are set.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=
EMAIL_FROM=
# Optional. A long random string; if blank, link signing uses a secret derived from DATABASE_URL.
EMAIL_TOKEN_SECRET=
# Optional. Turns on the bounce and complaint address for Amazon: /api/email/ses-events?key=THIS_VALUE
SES_EVENTS_KEY=
