# Placeholders only. Never put real values in this file: it is committed to GitHub.
DATABASE_URL=
NWS_CONTACT_EMAIL=
CRON_SECRET=

# Email (Amazon SES). Signup stays hidden until all four are set.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=
EMAIL_FROM=
# Optional. A long random string; if blank, link signing uses a secret derived from DATABASE_URL.
EMAIL_TOKEN_SECRET=
# Optional. Turns on the bounce and complaint address for Amazon: /api/email/ses-events?key=THIS_VALUE
SES_EVENTS_KEY=

# Text alerts (paid plan). Stay hidden until Twilio and all three Stripe values are set.
# Set TEXT_ALERTS=off to stop all alert texts at once.
# TWILIO_PHONE_NUMBER is the sending number, e.g. +19095551234.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Stripe: the secret key, the id of the $12 a year price (starts price_), and the signing
# secret of the webhook that points at /api/text/stripe (starts whsec_).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Terms and Privacy pages, and the footer of emails. LEGAL_OPERATOR is the person or company that
# runs the site, CONTACT_EMAIL a public address for questions, POSTAL_ADDRESS a mailing address (a PO box is fine).
LEGAL_OPERATOR=
CONTACT_EMAIL=
POSTAL_ADDRESS=
